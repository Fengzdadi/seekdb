# owner: storage
# owner group: storage
# description: TOKENIZE output and MATCH hits, order and relevance on Chinese, English and
#              mixed text, after an index build and after DML

--disable_warnings
drop database if exists fts_stability;
create database fts_stability;
use fts_stability;
set ob_query_timeout = 10000000000;
--enable_warnings

--result_format 4

# TOKENIZE on varied input and parser settings

select tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术，在大量文档索引和查询场景下可以显著降低 CPU 开销。', 'ik');
