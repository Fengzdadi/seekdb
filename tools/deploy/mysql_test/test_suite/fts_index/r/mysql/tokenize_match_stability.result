select i, p, tokenize('Full-text 全文索引 tokenizer 分词器, DATABASE database 数据库', p) from (select 1 i, 'ik' p union all select 2, 'beng' union all select 3, 'ik' union all select 4, 'space' union all select 5, 'ngram' union all select 6, 'IK' union all select 7, 'ngram2' union all select 8, 'beng' union all select 9, ' ik') x order by i;
+------+--------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| i    | p      | tokenize('Full-text 全文索引 tokenizer 分词器, DATABASE database 数据库', p)                                                                                                                                                                                                                                                                                                    |
+------+--------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
|    1 | ik     | ["full-text", "分词器", "tokenizer", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                          |
|    2 | beng   | ["text", "分词器", "tokenizer", "full", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                       |
|    3 | ik     | ["full-text", "分词器", "tokenizer", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                          |
|    4 | space  | ["text", "分词器", "tokenizer", "full", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                       |
|    5 | ngram  | ["ab", "ke", "数据", "词器", "at", "ni", "索引", "se", "ll", "da", "ba", "ta", "to", "xt", "fu", "ex", "er", "文索", "全文", "据库", "分词", "ze", "ok", "te", "en", "ul", "as", "iz"]                                                                                                                                                                                          |
|    6 | IK     | ["full-text", "分词器", "tokenizer", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                          |
|    7 | ngram2 | ["ab", "bas", "ke", "tok", "数据", "ful", "tex", "oke", "词器", "ase", "at", "ni", "索引", "se", "ll", "ull", "da", "ba", "ta", "分词器", "to", "xt", "fu", "ex", "er", "全文索", "文索", "全文", "eni", "据库", "分词", "ze", "ata", "ext", "aba", "数据库", "zer", "ize", "ok", "te", "tab", "dat", "en", "ul", "as", "iz", "文索引", "ken", "niz"]                           |
|    8 | beng   | ["text", "分词器", "tokenizer", "full", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                       |
|    9 |  ik    | ["full-text", "分词器", "tokenizer", "database", "数据库", "全文索引"]                                                                                                                                                                                                                                                                                                          |
+------+--------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
select i, tokenize(c, p) from (select 1 i, '数据库 database 全文索引' c, 'beng' p union all select 2, '数据库 database 全文索引', 'ik' union all select 3, 'database 数据库', 'beng' union all select 4, 'database 数据库', 'ik') x order by i;
+------+-------------------------------------------+
| i    | tokenize(c, p)                            |
+------+-------------------------------------------+
|    1 | ["database", "数据库", "全文索引"]        |
|    2 | ["database", "数据库", "全文索引"]        |
|    3 | ["database", "数据库"]                    |
|    4 | ["database", "数据库"]                    |
+------+-------------------------------------------+

create table docs (id int primary key, category int, title varchar(200), content text,
                   title_en varchar(200), content_en text);
insert into docs values
  (1, 1, '全文索引入门', '全文索引通过分词器把文本切分成词，再建立倒排索引。', 'Full-text index basics', 'A full-text index splits text into tokens and builds an inverted index.'),
  (2, 2, '分词器原理', 'IK分词器使用词典和最大匹配算法，支持智能模式和最细粒度模式。', 'Tokenizer internals', 'The tokenizer uses a dictionary and maximum matching.'),
  (3, 3, '数据库性能', 'OceanBase是一款非常稳定的数据库，查询性能优化依赖索引和统计信息。', 'Database performance', 'Database performance depends on indexes, statistics and a stable query plan.'),
  (4, 1, '倒排索引', '倒排索引记录每个词出现的文档，tokenizer的输出决定索引内容。', 'Inverted index', 'An inverted index maps each token to the documents that contain it.'),
  (5, 2, '相关性排序', 'BM25根据词频、文档长度和逆文档频率计算相关性。', 'Relevance ranking', 'BM25 ranks documents by term frequency, document length and inverse document frequency.'),
  (6, 3, '审计日志', '数据库审计记录每一次查询，用于安全分析。', 'Audit log', 'The database audit records every query for security analysis and performance audit.'),
  (7, 1, '稳定性', 'OceanBase 稳定 运行 database 集群，全文索引 分词器 稳定。', 'Stability', 'OceanBase keeps the database cluster stable under heavy load.'),
  (8, 2, '混合文本', 'Mixed 中英文 text：数据库database、索引index、查询query。', 'Mixed text', 'Mixed Chinese and English text about database index query.'),
  (9, 3, '数字和量词', '二〇二四年处理了三千五百万条记录，第一季度增长百分之十五。', 'Numbers', 'In 2024 the cluster processed 35 million records, 15 percent more.'),
  (10, 1, '重复词', '分词器分词器分词器全文索引全文索引倒排索引', 'Repeated words', 'database database database performance performance audit'),
  (11, 2, '空内容', '', 'Empty', ''),
  (12, 3, '大小写', 'DATABASE Database database 数据库', 'Case', 'DATABASE Database database Performance PERFORMANCE');
create fulltext index fti_all_ik on docs(title, content) with parser ik;
create fulltext index fti_content_ik on docs(content) with parser ik;
create fulltext index fti_en_beng on docs(title_en, content_en) with parser beng;
insert into docs values
  (13, 1, '新增文档', '在建好全文索引之后插入的文档也要能被分词器和倒排索引检索到。', 'Late insert', 'A document inserted after the index build is searchable with the tokenizer.'),
  (14, 2, '更新前', '更新之前的内容', 'Before update', 'content before the update');
update docs set content = '更新之后的全文索引内容，数据库 稳定', content_en = 'updated database content about performance' where id = 14;
delete from docs where id = 11;

